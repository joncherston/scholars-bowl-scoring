<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Nightly copy of server backups to this Mac. Install: see README (Backups). -->
<plist version="1.0">
<dict>
	<key>Label</key><string>edu.suscc.scholarsbowl.pull-backups</string>
	<key>ProgramArguments</key>
	<array><string>/bin/bash</string><string>/path/to/scholars-bowl-scoring/deploy/pull-backups.sh</string></array>
	<key>StartCalendarInterval</key><dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>30</integer></dict>
	<key>StandardOutPath</key><string>/Users/you/ScholarsBowlBackups/pull.log</string>
	<key>StandardErrorPath</key><string>/Users/you/ScholarsBowlBackups/pull.log</string>
</dict>
</plist>
