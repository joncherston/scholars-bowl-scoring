# Local development only (never used on the server).
# The dev server in .claude/launch.json sets SETUP_TOKEN to this value so the
# first admin can be created at http://localhost:5173/setup.
SETUP_TOKEN=local-dev-setup-code
DEV_ADMIN_NAME=Dev Admin
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=dev-password-123
